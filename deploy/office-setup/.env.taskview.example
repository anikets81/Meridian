# Database (Docker service name = db)
DB_HOST=db
DB_USER=taskview_db_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=taskviewdb
DB_PORT=5432

# Server
APP_PORT=1401
APP_URL=http://localhost:8888
API_URL=http://localhost:1725

# Authentication — password-only, simple registration (no email codes)
AUTH_LOGIN_METHODS=password
ALLOW_PUBLIC_REGISTRATION=true
REQUIRE_EMAIL_CONFIRMATION=false
PASSWORD_CHANGE_CONFIRMATION=password

# JWT — generate a long random string for production
JWT_ALG=HS256
JWT_SIGN=CHANGE_ME_long_random_jwt_secret
ACCESS_LIFE_TIME=3d
REFRESH_LIFE_TIME=9d

# CORS — add your web URL(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888,http://localhost:5174,http://127.0.0.1:5174

# Optional: 32-byte hex encryption key for integrations
# ENCRYPTION_KEY=

# SMTP (optional — not needed when REQUIRE_EMAIL_CONFIRMATION=false)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=tls
# SMTP_FROM_NAME=TaskView
# SMTP_FROM_EMAIL=
