# Set these on the Render Web Service (meridian-api) after Vercel is deployed.
# Dashboard → meridian-api → Environment

# Your Vercel frontend URL (no trailing slash)
APP_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Your Render API URL (Settings → meridian-api → URL)
API_URL=https://meridian-api.onrender.com
API_PUBLIC_URL=https://meridian-api.onrender.com
